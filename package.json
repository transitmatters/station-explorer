{
  "name": "station-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently npm:start-python npm:dev",
    "start-python": "cd server && uv run chalice local --port=5555",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint-frontend": "eslint . --max-warnings 15",
    "lint-backend": "uv run ruff check . && uv run ruff format --check .",
    "lint": "concurrently npm:lint-frontend npm:lint-backend",
    "postinstall": "uv sync && (uv run pre-commit install --install-hooks || true)",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@headlessui/react": "^2.2.10",
    "@mapbox/polyline": "^1.2.1",
    "@tanstack/query-sync-storage-persister": "5.105.1",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-query-persist-client": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "@turf/area": "^7.4.0",
    "@turf/length": "^7.4.0",
    "classnames": "^2.5.1",
    "leaflet": "^1.9.4",
    "osmtogeojson": "^3.0.0-beta.5",
    "pluralize": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-marker": "^2.1.1",
    "react-responsive": "^10.0.0",
    "react-toggle-dark-mode": "2.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@types/leaflet": "^1.9.22",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "osmtogeojson": {
      "@xmldom/xmldom": "^0.8.15"
    }
  }
}
