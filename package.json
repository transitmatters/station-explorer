{
  "name": "station-explorer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "concurrently npm:start-python npm:dev",
    "start-python": "cd server && poetry run chalice local --port=5000",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint-frontend": "eslint . --report-unused-disable-directives --max-warnings 15",
    "lint-backend": "cd server && poetry run flake8 && poetry run black . --check",
    "lint": "concurrently npm:lint-frontend npm:lint-backend",
    "postinstall": "cd server && poetry install",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20.13.0",
    "npm": ">=10.2.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@headlessui/react": "^2.1.4",
    "@mapbox/polyline": "^1.2.1",
    "@tanstack/react-query": "^5.54.1",
    "@tanstack/react-router": "^1.53.0",
    "@turf/area": "^7.1.0",
    "@turf/length": "^7.1.0",
    "classnames": "^2.5.1",
    "leaflet": "^1.9.4",
    "osmtogeojson": "^3.0.0-beta.5",
    "overpass-ts": "^4.3.8",
    "pluralize": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-marker": "^2.1.1",
    "react-responsive": "^10.0.0",
    "react-scroll": "^1.9.0",
    "react-toggle-dark-mode": "^1.1.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tanstack/router-vite-plugin": "^1.52.0",
    "@types/leaflet": "^1.9.12",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-scroll": "^1.8.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-plugin-unicorn": "^54.0.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "postcss": "^8.4.44",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
