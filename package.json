{
  "name": "station-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently npm:start-python npm:dev",
    "start-python": "cd server && poetry run chalice local --port=5555",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint-frontend": "eslint . --report-unused-disable-directives --max-warnings 15",
    "lint-backend": "cd server && poetry run flake8 && poetry run black . --check",
    "lint": "concurrently npm:lint-frontend npm:lint-backend",
    "postinstall": "cd server && poetry install",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@headlessui/react": "^2.2.7",
    "@mapbox/polyline": "^1.2.1",
    "@tanstack/query-sync-storage-persister": "5.100.8",
    "@tanstack/react-query": "5.100.8",
    "@tanstack/react-query-persist-client": "5.100.8",
    "@tanstack/react-router": "1.169.1",
    "@turf/area": "^7.1.0",
    "@turf/length": "^7.1.0",
    "classnames": "^2.5.1",
    "leaflet": "^1.9.4",
    "osmtogeojson": "^3.0.0-beta.5",
    "pluralize": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-marker": "^2.1.1",
    "react-responsive": "^10.0.0",
    "react-scroll": "^1.9.0",
    "react-toggle-dark-mode": "2.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tanstack/router-vite-plugin": "1.166.47",
    "@types/leaflet": "^1.9.17",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@types/react-scroll": "^1.8.10",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react-swc": "4.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.8.3",
    "vite": "8.0.10"
  }
}
